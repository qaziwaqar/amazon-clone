# Copy to .env.local and fill in. Never commit .env.local — .gitignore covers it.

# Neon Postgres, pooled connection string (the one with -pooler in the host).
# Phase 02 is blocked on this.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Signing key for the session JWT. Phase 08.
# Generate with: openssl rand -base64 32
JWT_SECRET=""

# Public origin, used for absolute URLs in metadata and OG images.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
